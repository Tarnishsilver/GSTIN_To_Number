NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gstin_contact

REDIS_URL=redis://localhost:6379

# GST Provider: mock | cleartax | official | authorized_api
GST_PROVIDER=mock
GST_API_URL=
GST_CLIENT_ID=
GST_CLIENT_SECRET=
CLEARTAX_BASE_URL=https://cleartax.in

# Search Provider: mock | google-dork | google | serpapi
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

RATE_LIMIT_WINDOW=3600
RATE_LIMIT_MAX=100

LOOKUP_CACHE_TTL=86400
BUSINESS_SEARCH_CACHE_TTL=604800

# Dorking config (for google-dork provider)
DORK_DELAY_MIN_MS=2000
DORK_DELAY_MAX_MS=5000
BROWSER_TIMEOUT_MS=30000
DORK_HEADFUL=false
