generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                 String   @id @default(uuid())
  gstin              String   @unique
  legalName          String?
  tradeName          String?
  registrationStatus String?
  registrationDate   String?
  businessType       String?
  building           String?
  street             String?
  locality           String?
  city               String?
  district           String?
  state              String?
  stateCode          String?
  pincode            String?
  country            String?
  website            String?
  source             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  contacts Contact[]
  lookups  Lookup[]

  @@index([gstin])
}

model Contact {
  id              String   @id @default(uuid())
  businessId      String
  type            String
  value           String
  normalizedValue String
  confidence      Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sources  ContactSource[]

  @@index([businessId])
  @@index([type, normalizedValue])
}

model ContactSource {
  id             String   @id @default(uuid())
  contactId      String
  sourceType     String
  sourceUrl      String?
  firstSeenAt    DateTime @default(now())
  lastVerifiedAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model Lookup {
  id          String    @id @default(uuid())
  gstin       String
  status      String    @default("pending")
  error       String?
  result      Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  business   Business? @relation(fields: [businessId], references: [id])
  businessId String?

  @@index([gstin])
  @@index([status])
}

model ProviderResult {
  id        String   @id @default(uuid())
  lookupId  String
  provider  String
  status    String
  duration  Int?
  error     String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([lookupId])
}
